# Browser-safe Supabase project settings (safe to expose as NEXT_PUBLIC_ variables).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# GitHub Actions secrets only; never expose these as NEXT_PUBLIC_ variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# GitHub Actions secret for the Render service this keepalive bot should ping every 10 minutes.
# Example: https://your-service.onrender.com/health
RENDER_URL=https://YOUR_RENDER_SERVICE.onrender.com/
